---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Página não encontrada - Renata Torres" 
  description="A página que você está procurando não existe." 
  image="/assets/hero-1.jpg" 
  url="https://www.renatatorres.com/404">

  <main class="flex flex-col items-center justify-center min-h-screen text-center px-4 bg-background text-text">
    <h1 class="text-9xl font-bold mb-2 text-primary">404</h1>
    <h2 class="text-3xl font-semibold mb-6">Página não encontrada</h2>
    <p class="text-lg mb-8 max-w-md">
      Desculpe, a página que você está procurando não existe ou foi movida.
    </p>
    
    <a href="/" class="block w-fit rounded-lg px-8 py-2.5 text-sm font-bold bg-primary text-card shadow-lg shadow-primary/50 hover:text-text hover:bg-card transition duration-300 ease-in-out hover:shadow-xl hover:shadow-primary/50">
      Voltar para o início
    </a>
  </main>
  
</Layout>
